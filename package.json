{
  "name": "wppconnect",
  "version": "1.0.62",
  "description": "Wppconnect Chrome Extension that allows you to send messages in bulk via WhatsApp™ Web",
  "main": "index.js",
  "scripts": {
    "prewatch": "node scripts/download-wa-js-release.js && node scripts/patch-wa-js-runtime.js",
    "watch": "webpack --config webpack/webpack.dev.js --watch --progress",
    "predev": "node scripts/download-wa-js-release.js && node scripts/patch-wa-js-runtime.js",
    "dev": "tsc --noEmit && webpack --config webpack/webpack.dev.js",
    "prebuild": "node scripts/download-wa-js-release.js && node scripts/patch-wa-js-runtime.js",
    "build": "tsc --noEmit && webpack --config webpack/webpack.prod.js",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test scripts/__tests__/*.test.js"
  },
  "author": "wppconnect-team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wppconnect-team/wppconnect-extension.git"
  },
  "dependencies": {
    "@wppconnect/wa-js": "4.6.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "scheduler": "^0.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/recommended": "^1.0.13",
    "@types/chrome": "^0.3.4",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "cssnano": "^9.4.0",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.29",
    "postcss-loader": "^8.2.1",
    "qrcode-terminal": "^0.12.0",
    "rimraf": "^6.1.3",
    "speed-measure-webpack-plugin": "^1.6.0",
    "tailwindcss": "^4.3.3",
    "ts-loader": "^9.6.2",
    "typescript": "~6.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-merge": "^6.0.1"
  }
}
